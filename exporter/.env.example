# Copy to .env and adjust. The exporter reads these from the environment.

# Serial device of the SHT45 Trinkey (the *data* CDC port, see trinkey/boot.py).
#   Windows:  COM5
#   macOS:    /dev/cu.usbmodem1101
#   Linux:    prefer a STABLE name over /dev/ttyACMx (that depends on plug order):
#             - /dev/serial/by-id/usb-Adafruit_..._Trinkey_<serial>-if02   (data)
#             - or /dev/sht45 via the udev rule in udev/99-sht45-trinkey.rules
SCPI_PORT=/dev/serial/by-id/usb-Adafruit_SHT4x_Trinkey_XXXX-if02

SCPI_BAUD=115200
SCPI_TIMEOUT=2.0
POLL_INTERVAL=5.0
EXPORTER_PORT=9101

# Optional: adds a 'location' label to every metric.
LOCATION=

# Humidity limits (%). When set, the exporter pushes these to the Trinkey over
# SCPI on connect, so the status LED follows this config (green inside the band,
# amber within HUM_WARN of a limit, red outside). Leave empty to keep the
# firmware's own settings.toml defaults.
HUM_LOW=35
HUM_HIGH=70
HUM_WARN=5
# Status-LED brightness, 0.0 (off) .. 1.0 (full).
BRIGHTNESS=0.2

# Calibration vs a trusted reference next to the Trinkey (offset = ref - trinkey).
# TEMP_OFFSET degC added to temperature; HUM_OFFSET %RH residual after the
# firmware's saturation-curve compensation of RH to the corrected temperature.
TEMP_OFFSET=-3.6
HUM_OFFSET=5.7
