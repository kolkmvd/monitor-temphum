# Copy to .env and adjust. The exporter reads these from the environment.

# Serial device of the SHT45 Trinkey (the *data* CDC port, see trinkey/boot.py).
#   Windows:  COM5
#   macOS:    /dev/cu.usbmodem1101
#   Linux:    prefer a STABLE name over /dev/ttyACMx (that depends on plug order):
#             - /dev/serial/by-id/usb-Adafruit_..._Trinkey_<serial>-if02   (data)
#             - or /dev/sht45 via the udev rule in udev/99-sht45-trinkey.rules
SCPI_PORT=/dev/serial/by-id/usb-Adafruit_SHT4x_Trinkey_XXXX-if02

SCPI_BAUD=115200
SCPI_TIMEOUT=2.0
POLL_INTERVAL=5.0
EXPORTER_PORT=9101

# Optional: adds a 'location' label to every metric.
LOCATION=
