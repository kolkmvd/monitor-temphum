# Machine-specific values for docker compose. Copy to .env (git-ignored):
#   cp .env.example .env   &&   edit it.
# Docker Compose auto-substitutes these into docker-compose.yml.

# Serial device of the SHT45 Trinkey (the data/SCPI port = the -if02 interface).
# Find it with: ls -l /dev/serial/by-id/
SCPI_PORT=/dev/serial/by-id/usb-Adafruit_SHT4x_Trinkey_XXXX-if02

# Optional 'location' label added to every metric (e.g. which organ/room).
LOCATION=serverroom

# Public host for the Grafana dashboard via Traefik -> https://<host>/grafana
GRAFANA_HOST=lombok2024.myoss.io
